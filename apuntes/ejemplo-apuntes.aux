\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Una generación de CMA-ES. Toda la información se guarda en la distribución normal $\mathcal  {N}(m,\sigma ^2 C)$: los pasos 3, 4 y 5 actualizan su centro, su tamaño y su forma.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cmaciclo}{{8}{8}{Una generación de CMA-ES. Toda la información se guarda en la distribución normal $\mathcal {N}(m,\sigma ^2 C)$: los pasos 3, 4 y 5 actualizan su centro, su tamaño y su forma}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Pasos sucesivos de la media (azul) y su suma acumulada, el camino de evolución (rojo). Si el camino es más largo de lo esperado por azar, el paso es demasiado pequeño; si es más corto, demasiado grande.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:camino}{{9}{8}{Pasos sucesivos de la media (azul) y su suma acumulada, el camino de evolución (rojo). Si el camino es más largo de lo esperado por azar, el paso es demasiado pequeño; si es más corto, demasiado grande}{figure.caption.9}{}}
