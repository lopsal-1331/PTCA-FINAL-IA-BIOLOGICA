${1:f}(${2:x} + ${3:h}) = ${1:f}(${2:x}) + ${1:f}'(${2:x})${3:h} + ${1:f}''(${2:x}) \\frac{${3:h}^{2}}{2!} + \\dots$4$0
endsnippet

# x3 -> x_{3}, \alpha3 -> \alpha_{3}, \leq3 -> \leq 3
priority -1
context math(context)
snippet /(\\?)([A-Za-z]+)(\d)/ "Subindice automatico" Ai
`
const greek = /^(?:alpha|beta|gamma|Gamma|delta|Delta|epsilon|varepsilon|zeta|eta|theta|vartheta|Theta|iota|kappa|lambda|Lambda|mu|nu|xi|omicron|pi|rho|varrho|sigma|Sigma|tau|upsilon|Upsilon|phi|varphi|Phi|chi|psi|omega|Omega)$/;
if (m[1] !== "\\") rv = m[2] + "_{" + m[3] + "}";
else if (greek.test(m[2])) rv = "\\" + m[2] + "_{" + m[3] + "}";
else rv = "\\" + m[2] + " " + m[3];
`
endsnippet
