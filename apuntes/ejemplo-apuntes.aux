\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Esquema ilustrativo (no son datos reales). Con muchos datos, el fitness y el error de validación bajan juntos. Con pocos datos, la búsqueda sigue bajando el fitness, pero la validación no mejora: está aprendiendo el ruido de los pliegues.}}{11}{figure.caption.13}\protected@file@percent }
\newlabel{fig:sobreajuste}{{13}{11}{Esquema ilustrativo (no son datos reales). Con muchos datos, el fitness y el error de validación bajan juntos. Con pocos datos, la búsqueda sigue bajando el fitness, pero la validación no mejora: está aprendiendo el ruido de los pliegues}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces El punto $q$ está en el borde de los datos y todos sus vecinos quedan a su izquierda. KNN predice su media (cuadrado naranja), que subestima el valor real. La regresión lineal local ajusta una recta a los mismos vecinos y la evalúa en $q$ (triángulo verde), con lo que recupera la tendencia y casi elimina el sesgo.}}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:sesgoborde}{{14}{11}{El punto $q$ está en el borde de los datos y todos sus vecinos quedan a su izquierda. KNN predice su media (cuadrado naranja), que subestima el valor real. La regresión lineal local ajusta una recta a los mismos vecinos y la evalúa en $q$ (triángulo verde), con lo que recupera la tendencia y casi elimina el sesgo}{figure.caption.14}{}}
