\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Esquema de la búsqueda sobre una función con un valle inclinado (curvas de nivel en gris, óptimo en rojo). La nube empieza amplia, se alarga en la dirección del valle gracias a $C$ y se encoge al acercarse al óptimo gracias a $\sigma $. La línea naranja es la trayectoria de la media $m$.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cmaelipses}{{10}{9}{Esquema de la búsqueda sobre una función con un valle inclinado (curvas de nivel en gris, óptimo en rojo). La nube empieza amplia, se alarga en la dirección del valle gracias a $C$ y se encoge al acercarse al óptimo gracias a $\sigma $. La línea naranja es la trayectoria de la media $m$}{figure.caption.10}{}}
