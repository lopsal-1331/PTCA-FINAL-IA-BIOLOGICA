\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Vecindario del punto $q$ (rojo) según la representación. (a) Si $x_1$ se mide en miles, una pequeña diferencia en $x_1$ pesa muchísimo: solo son vecinos los puntos con $x_1$ casi igual, sea cual sea $x_2$. (b) Tras estandarizar, ambos atributos cuentan igual y el vecindario es un círculo. (c) Si se aprende que $x_1$ es poco relevante ($w_1$ pequeño), el vecindario se alarga en esa dirección y los vecinos se eligen sobre todo por $x_2$.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:vecindarios}{{1}{3}{Vecindario del punto $q$ (rojo) según la representación. (a) Si $x_1$ se mide en miles, una pequeña diferencia en $x_1$ pesa muchísimo: solo son vecinos los puntos con $x_1$ casi igual, sea cual sea $x_2$. (b) Tras estandarizar, ambos atributos cuentan igual y el vecindario es un círculo. (c) Si se aprende que $x_1$ es poco relevante ($w_1$ pequeño), el vecindario se alarga en esa dirección y los vecinos se eligen sobre todo por $x_2$}{figure.caption.1}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.1.3}Árbol de decisión como experimento de control}{3}{subsubsection.2.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Valores 2, 3, 4 y 5 (azul) y un valor extremo de 500 (rojo). En la escala original los valores normales quedan apilados junto al cero y son indistinguibles. Tras aplicar $\log (x+1)$ (Yeo-Johnson con $\lambda =0$) se separan, y el valor extremo deja de acaparar todo el rango.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:compresion}{{2}{4}{Valores 2, 3, 4 y 5 (azul) y un valor extremo de 500 (rojo). En la escala original los valores normales quedan apilados junto al cero y son indistinguibles. Tras aplicar $\log (x+1)$ (Yeo-Johnson con $\lambda =0$) se separan, y el valor extremo deja de acaparar todo el rango}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Una transformación creciente (aquí $\log (x+1)$) cambia las distancias entre puntos pero no su orden. El umbral $t$ y su imagen $t'=\psi (t)$ separan exactamente los mismos puntos (azul a la izquierda, naranja a la derecha), así que el árbol encuentra las mismas particiones.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:arbol}{{3}{4}{Una transformación creciente (aquí $\log (x+1)$) cambia las distancias entre puntos pero no su orden. El umbral $t$ y su imagen $t'=\psi (t)$ separan exactamente los mismos puntos (azul a la izquierda, naranja a la derecha), así que el árbol encuentra las mismas particiones}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}La transformación aprendida}{4}{subsection.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.1}Paso 1: \textit  {Yeo-Johnson}}{4}{subsubsection.2.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cada atributo pasa por tres etapas, cada una con un propósito distinto. Los parámetros aprendidos son $\lambda _j$ y $w_j$; $\mu _j$ y $\sigma _j$ se calculan con los datos de entrenamiento.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:pipeline}{{4}{5}{Cada atributo pasa por tres etapas, cada una con un propósito distinto. Los parámetros aprendidos son $\lambda _j$ y $w_j$; $\mu _j$ y $\sigma _j$ se calculan con los datos de entrenamiento}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Transformación de Yeo-Johnson para varios $\lambda $. Con $\lambda =1$ es la identidad (línea discontinua). Con $\lambda <1$ la curva se aplana para $x$ grandes: comprime la cola derecha. Con $\lambda >1$ se empina: la estira. Todas las curvas son crecientes, así que nunca cambian el orden de los datos.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:yeojohnson}{{5}{5}{Transformación de Yeo-Johnson para varios $\lambda $. Con $\lambda =1$ es la identidad (línea discontinua). Con $\lambda <1$ la curva se aplana para $x$ grandes: comprime la cola derecha. Con $\lambda >1$ se empina: la estira. Todas las curvas son crecientes, así que nunca cambian el orden de los datos}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.2}Paso 2 y 3: estandarizar y ponderar}{5}{subsubsection.2.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.3}Conexión con la teoría de métricas}{6}{subsubsection.2.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Puntos a distancia 1 del centro según el tipo de métrica. La euclídea trata todas las direcciones igual. La diagonal estira o encoge cada eje por separado, pero los ejes de la elipse siguen alineados con los atributos. La completa puede además rotar la elipse, combinando atributos, a costa de muchos más parámetros.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:mahalanobis}{{6}{6}{Puntos a distancia 1 del centro según el tipo de métrica. La euclídea trata todas las direcciones igual. La diagonal estira o encoge cada eje por separado, pero los ejes de la elipse siguen alineados con los atributos. La completa puede además rotar la elipse, combinando atributos, a costa de muchos más parámetros}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.4}El vector de parámetros}{6}{subsubsection.2.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Con $\lambda \approx 13{,}6$, los valores negativos de la longitud se elevan a $2-\lambda =-11{,}6$, lo que da números prácticamente nulos. Todos los puntos acaban en el mismo valor y el atributo deja de servir para medir distancias. Limitar $\lambda \in [-2,2]$ lo evita.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:colapso}{{7}{7}{Con $\lambda \approx 13{,}6$, los valores negativos de la longitud se elevan a $2-\lambda =-11{,}6$, lo que da números prácticamente nulos. Todos los puntos acaban en el mismo valor y el atributo deja de servir para medir distancias. Limitar $\lambda \in [-2,2]$ lo evita}{figure.caption.7}{}}
